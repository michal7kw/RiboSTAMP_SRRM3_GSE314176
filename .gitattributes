# Force LF line endings on text files that will run on the HPC (Linux).
# Without this, Windows checkouts can introduce CRLF that breaks bash scripts.
* text=auto eol=lf

# Explicit overrides for files where line ending matters at runtime
*.sh   text eol=lf
*.py   text eol=lf
*.R    text eol=lf
*.Rmd  text eol=lf
*.bed  text eol=lf
*.tsv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# Treat these as binary so git doesn't try to diff or convert them
*.png    binary
*.pdf    binary
*.gz     binary
*.bam    binary
*.bai    binary
*.mtx    binary
*.rds    binary
*.h5ad   binary
*.h5     binary
*.xlsx   binary
*.tar    binary
